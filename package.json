{
  "name": "windplay",
  "version": "0.1.0",
  "private": true,
  "description": "A playground for point clouds, particle animation, interactive art, and browser games",
  "workspaces": [
    "works/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "dev:point-cloud": "npm run dev --workspace @windplay/point-cloud-studio",
    "dev:reel": "npm run dev --workspace @windplay/tingfeng-reel",
    "dev:voxel": "npm run dev --workspace @windplay/voxel-frontier",
    "dev:survival": "npm run dev --workspace @windplay/ember-wilds",
    "dev:runner": "npm run dev --workspace @windplay/metro-rush",
    "dev:shooter": "npm run dev --workspace @windplay/strike-arena",
    "build": "npm run build:works && npm run build:site",
    "build:works": "npm run build --workspaces --if-present",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.cjs && npm run test:works",
    "test:works": "npm run test --workspaces --if-present"
  }
}
