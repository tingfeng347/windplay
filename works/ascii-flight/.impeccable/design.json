  "components": [
    {
      "name": "起飞主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "开始飞行与重新起飞。",
      "html": "<button class=\"ds-primary\">开始飞行</button>",
      "css": ".ds-primary{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;background:var(--accent,#f5bb55);color:#151617;border:1px solid var(--accent,#f5bb55);border-radius:5px;padding:13px;width:100%;font-weight:bold;cursor:pointer}.ds-primary:hover{background:#ffd185;color:#151617}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-route:focus-visible,.ds-link:focus-visible{outline:2px solid var(--accent,#f5bb55);outline-offset:4px}"
    },
    {
      "name": "次级动作",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "暂停、重飞、操纵说明。",
      "html": "<button class=\"ds-secondary\">重飞</button>",
      "css": ".ds-secondary{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;background:#12191b;color:var(--ink,#e6e5d8);border:1px solid #647071;padding:9px 15px;border-radius:5px;cursor:pointer}.ds-secondary:hover{border-color:var(--accent,#f5bb55);color:var(--accent,#f5bb55)}.ds-secondary:disabled{opacity:.4;cursor:default}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-route:focus-visible,.ds-link:focus-visible{outline:2px solid var(--accent,#f5bb55);outline-offset:4px}"
    },
    {
      "name": "航线选择",
      "kind": "input",
      "refersTo": "route-field",
      "description": "原生选择字段与冷灰标签。",
      "html": "<label class=\"ds-route-label\" for=\"ds-route\">选择航线</label><select class=\"ds-route\" id=\"ds-route\"><option>沿街初航 · 8 道航门</option><option>自由飞行</option></select>",
      "css": ".ds-route-label{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;display:block;font-size:12px;color:var(--muted,#acb4b5);margin-bottom:8px}.ds-route{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;background:#111c20;color:var(--ink,#e6e5d8);border:1px solid #5e6b6c;padding:12px;width:100%;border-radius:5px}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-route:focus-visible,.ds-link:focus-visible{outline:2px solid var(--accent,#f5bb55);outline-offset:4px}"
    },
    {
      "name": "中央状态面板",
      "kind": "card",
      "refersTo": "state-panel",
      "description": "起飞与结果层。",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">穿过字符里的城市</h2><p class=\"ds-panel-copy\">楼房、树木、道路，都是一行行彩色字符。</p></section>",
      "css": ".ds-panel{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;background:#071012f5;color:var(--ink,#e6e5d8);padding:30px;border:1px solid #5e6b6c;border-radius:10px;box-shadow:0 18px 70px #000c;width:min(470px,calc(100% - 32px))}.ds-panel-title{font:500 25px/1.4 \"Courier New\",monospace;margin:0 0 16px}.ds-panel-copy{font-size:13px;line-height:1.9;color:var(--muted,#acb4b5);margin:0 0 18px}"
    },
    {
      "name": "飞行仪表",
      "kind": "custom",
      "refersTo": "telemetry",
      "description": "空速、高度与航向读数；不透明黑色底板隔开场景字符。",
      "html": "<div class=\"ds-instruments\"><div class=\"ds-meter\"><span class=\"ds-meter-label\">空速</span><strong class=\"ds-meter-value\">25</strong><small class=\"ds-meter-unit\">m/s</small></div></div>",
      "css": ".ds-instruments{display:flex;gap:32px;background:#000;padding:12px 15px;border-radius:4px;pointer-events:none}.ds-meter{font-family:\"Courier New\",\"Noto Sans Mono\",monospace;font-size:13px;display:grid;grid-template-columns:auto auto;align-items:baseline;gap:5px;color:var(--ink,#e6e5d8)}.ds-meter-label{font-size:11px;color:var(--muted,#acb4b5);grid-column:1/3}.ds-meter-value{font-size:28px;line-height:1;font-weight:500;font-variant-numeric:tabular-nums}.ds-meter-unit{font-size:11px;color:var(--muted,#acb4b5)}@media(max-width:650px){.ds-instruments{gap:16px;padding:10px}.ds-meter-value{font-size:21px}}"
    },
    {
